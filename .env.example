# Valiant v3 — Environment Configuration
# Copy this file to .env and fill in your values

# ── Database ─────────────────────────────────────────────
# SQLite (default, no setup needed):
VALIANT_DATABASE_URL=sqlite:///./valiant.db
# PostgreSQL (production):
# VALIANT_DATABASE_URL=postgresql://user:password@localhost:5432/valiant

# ── API Authentication ────────────────────────────────────
# Comma-separated list of valid API keys (clients pass as X-API-Key header)
# Leave empty to disable auth in development
VALIANT_API_KEYS=dev-key-change-me-in-production

# ── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed origins for the REST API
VALIANT_ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000

# ── Ports ────────────────────────────────────────────────
VALIANT_API_PORT=8000
VALIANT_UI_PORT=8501

# ── Logging ──────────────────────────────────────────────
VALIANT_LOG_LEVEL=INFO
# Set to "json" for structured JSON logs in production
VALIANT_LOG_FORMAT=console

# ── Workflow discovery ────────────────────────────────────
# Extra directories to scan for workflow classes (colon-separated)
# VALIANT_WORKFLOW_DIRS=./my_workflows:./shared_workflows

# ── Execution ────────────────────────────────────────────
VALIANT_DEFAULT_TIMEOUT=120.0
VALIANT_MAX_PARALLEL_STEPS=10
